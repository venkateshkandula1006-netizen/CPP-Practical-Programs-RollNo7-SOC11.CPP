#include <iostream>
using namespace std;

class Circle
{
    float radius, area;

public:

    void AreaOfCircle()
    {
        cout << "Enter Radius: ";
        cin >> radius;

        area = 3.14 * radius * radius;

        cout << "Area = " << area << endl;
    }
};

int main()
{
    Circle c1;

    c1.AreaOfCircle();

    return 0;
}
